@startuml
'https://plantuml.com/class-diagram

+abstract class Employee{
-firstName:String
-lastName:String
-socialSecurityNum:String
+getFirstName():String
+getLastName():String
+getSocialSecurityNum():String
+setFirstName(String firstName):void
+setLastName(String lastName):void
+setSocialSecurityNum(String socialSecurityNum):void
+toString():String
}

+class HourlyEmployee{
-wage:int
-hoursWorked:int
+setWage(int wage):void
+setHoursWorked(int hoursWorked):void
+getWage():int
+getHoursWorked():int
+toString():String
}
+class CommissionEmployee{
-commissionRate:int
-grossSales:int
+getCommissionRate():int
+getGrossSales():int
+setCommissionRate(int commissionRate):void
+setGrossSales():void
+toString():String
}
+class BaseEmployee{
-baseSalary:int
+getBaseSalary():int
+setBaseSalary(int baseSalary):void
+toString():String
}
+class SalariedEmployee{
-weeklySalary:int
+getSalary():int
+setSalary():void
+toString():String
}

Employee <|-- HourlyEmployee
Employee <|-- CommissionEmployee
Employee <|-- BaseEmployee
Employee <|-- SalariedEmployee



@enduml